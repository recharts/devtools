{
  "name": "@recharts/devtools",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "version": "0.0.14",
  "description": "Devtools and helper functions for Recharts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "url": "https://github.com/recharts/devtools"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "format": "prettier --write \"{src,test}/**/*.ts\""
  },
  "keywords": [
    "recharts",
    "devtools",
    "charts"
  ],
  "author": "Recharts Group",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "3.9.0-canary.0"
  }
}
